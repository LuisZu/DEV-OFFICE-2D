NODE_ENV=development
PORT=3000

# SQL Server connection string used by Prisma.
# Format: sqlserver://host:port;database=<db>;user=<user>;password=<password>;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=devoffice;user=devoffice;password=change-me;trustServerCertificate=true"

# Access token
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=15m

# Refresh token
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=debug

# Initial passwords used by prisma/seed.ts (local/dev only — override in shared envs)
SEED_ADMIN_PASSWORD=ChangeMe#Admin1
SEED_MANAGER_PASSWORD=ChangeMe#Manager1
SEED_DEVELOPER_PASSWORD=ChangeMe#Dev1
