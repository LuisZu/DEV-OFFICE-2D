# Used by docker-compose.yml to configure the sqlserver, backend and frontend
# containers. Copy to ".env" and adjust before running `docker compose up`.

# --- SQL Server ---
MSSQL_SA_PASSWORD=DevOffice#2026Docker
MSSQL_PORT=1433

# --- Backend ---
BACKEND_PORT=3000
DATABASE_URL="sqlserver://sqlserver:1433;database=devoffice;user=sa;password=DevOffice#2026Docker;trustServerCertificate=true"
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
